header: <WebCore/CoordinatedLayerProperties.h>
[CustomHeader, OptionSet] enum class WebCore::CoordinatedLayerChange : uint64_t {
    Position,
    BoundsOrigin,
    AnchorPoint,
    Size,
    Transform,
    ChildrenTransform,
    Preserves3D,
    MasksToBounds,
    BackfaceVisibility,
    BackgroundColor,
    Opacity,
    BlendMode,
    BackingStore,
    ContentsVisible,
    ContentsOpaque,
    ContentsRect,
    ContentsRectClipsDescendants,
    ContentsClippingRect,
    ContentsClipShapePath,
    ContentsTileSize,
    ContentsTilePhase,
    ContentsColor,
    ClipPath,
    ClipPathWindRule,
    Filters,
    Mask,
    Replica,
    BackdropFilters,
    BackdropRect,
    BackdropShapePath,
    BackdropRoot,
    DebugBorderColor,
    DebugBorderWidth,
    RepaintCount,
    Children,
    Animations,
    ContentsBuffer,
    ContentsImage,
}

header: <WebCore/CoordinatedPlatformLayerBuffer.h>
[CustomHeader, Nested] enum class WebCore::CoordinatedPlatformLayerBuffer::AlphaMode : uint8_t {
    Opaque,
    Premultiplied,
    Unpremultiplied,
}

header: <WebCore/CoordinatedPlatformLayerBuffer.h>
[CustomHeader, Nested] enum class WebCore::CoordinatedPlatformLayerBuffer::Origin : bool

header: <WebCore/CoordinatedLayerProperties.h>
[CustomHeader] struct WebCore::CoordinatedRemoteContentsBuffer {
    WebCore::CoordinatedContentsIdentifier identifier;
    WebCore::CoordinatedPlatformLayerBuffer::AlphaMode alphaMode;
    WebCore::CoordinatedPlatformLayerBuffer::Origin origin;
}

header: <WebCore/GraphicsLayerClient.h>
[CustomHeader] enum class WebCore::AnimatedProperty : uint8_t {
    Invalid,
    Translate,
    Scale,
    Rotate,
    Transform,
    Opacity,
    BackgroundColor,
    Filter,
    WebkitBackdropFilter,
}

header: <WebCore/GraphicsLayerAnimation.h>
[CustomHeader, Nested] enum class WebCore::GraphicsLayerAnimation::Direction : uint8_t {
    Normal,
    Alternate,
    Reverse,
    AlternateReverse,
}

header: <WebCore/AcceleratedAnimation.h>
[CustomHeader, Nested] struct WebCore::AcceleratedAnimation::Keyframe {
    double keyTime;
    Variant<float, WebCore::TransformOperations, WebCore::FilterOperations> value;
    RefPtr<WebCore::TimingFunction> timingFunction;
}

header: <WebCore/AcceleratedAnimation.h>
[CustomHeader, Nested] enum class WebCore::AcceleratedAnimation::State : uint8_t {
    Playing,
    Paused,
    Stopped,
}

header: <WebCore/AcceleratedAnimation.h>
[CustomHeader, Nested] struct WebCore::AcceleratedAnimation::Playback {
    MonotonicTime startTime;
    Seconds pauseTime;
    WebCore::AcceleratedAnimation::State state;
}

header: <WebCore/AcceleratedAnimation.h>
[CustomHeader, RefCounted] class WebCore::AcceleratedAnimation {
    String name();
    WebCore::AnimatedProperty property();
    Vector<WebCore::AcceleratedAnimation::Keyframe> keyframeValues();
    Ref<WebCore::TimingFunction> timingFunction();
    RefPtr<WebCore::TimingFunction> defaultTimingFunctionForKeyframes();
    double iterationCount();
    double duration();
    WebCore::GraphicsLayerAnimation::Direction direction();
}

header: <WebCore/AcceleratedAnimations.h>
[CustomHeader, Nested] struct WebCore::AcceleratedAnimations::Transforms {
    WebCore::TransformationMatrix translate;
    WebCore::TransformationMatrix rotate;
    WebCore::TransformationMatrix scale;
    WebCore::TransformationMatrix transform;
}

header: <WebCore/AcceleratedAnimations.h>
[CustomHeader, Nested] struct WebCore::AcceleratedAnimations::Entry {
    Ref<WebCore::AcceleratedAnimation> animation;
    WebCore::AcceleratedAnimation::Playback playback;
}

header: <WebCore/AcceleratedAnimations.h>
[CustomHeader] class WebCore::AcceleratedAnimations {
    WebCore::AcceleratedAnimations::Transforms transforms();
    Vector<WebCore::AcceleratedAnimations::Entry> animations();
}

header: <WebCore/CoordinatedLayerProperties.h>
struct WebCore::CoordinatedLayerProperties {
    [Validator='id'] WebCore::PlatformLayerIdentifier id;
    [OptionalTupleBits] OptionSet<WebCore::CoordinatedLayerChange> changes;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Position] WebCore::FloatPoint position;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BoundsOrigin] WebCore::FloatPoint boundsOrigin;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::AnchorPoint] WebCore::FloatPoint3D anchorPoint;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Size] WebCore::FloatSize size;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Transform] WebCore::TransformationMatrix transform;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ChildrenTransform] WebCore::TransformationMatrix childrenTransform;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Preserves3D] bool preserves3D;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::MasksToBounds] bool masksToBounds;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackfaceVisibility] bool backfaceVisibility;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackgroundColor] WebCore::Color backgroundColor;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Opacity] float opacity;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BlendMode] WebCore::BlendMode blendMode;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackingStore] bool hasBackingStore;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsVisible] bool contentsVisible;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsOpaque] bool contentsOpaque;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsRect] WebCore::FloatRect contentsRect;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsRectClipsDescendants] bool contentsRectClipsDescendants;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsClippingRect] WebCore::FloatRoundedRect contentsClippingRect;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsClipShapePath] WebCore::Path contentsClipShapePath;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsTileSize] WebCore::FloatSize contentsTileSize;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsTilePhase] WebCore::FloatSize contentsTilePhase;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsColor] WebCore::Color contentsColor;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ClipPath] WebCore::Path clipPath;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ClipPathWindRule] WebCore::WindRule clipPathWindRule;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Filters] WebCore::FilterOperations filters;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Mask] std::optional<WebCore::PlatformLayerIdentifier> mask;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Replica] std::optional<WebCore::PlatformLayerIdentifier> replica;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackdropFilters] WebCore::FilterOperations backdropFilters;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackdropRect] WebCore::FloatRoundedRect backdropRect;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackdropShapePath] WebCore::Path backdropShapePath;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::BackdropRoot] bool isBackdropRoot;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::DebugBorderColor] WebCore::Color debugBorderColor;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::DebugBorderWidth] std::optional<float> debugBorderWidth;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::RepaintCount] std::optional<unsigned> repaintCount;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Children] Vector<WebCore::PlatformLayerIdentifier> children;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::Animations] WebCore::AcceleratedAnimations animations;
    [OptionalTupleBit=WebCore::CoordinatedLayerChange::ContentsBuffer] std::optional<WebCore::CoordinatedRemoteContentsBuffer> contentsBuffer;
}

header: "CoordinatedLayerTreeTransaction.h"
[CustomHeader] struct WebKit::CoordinatedPixels {
    uint64_t offset;
    WebCore::IntSize size;
}

header: "CoordinatedLayerTreeTransaction.h"
[CustomHeader] struct WebKit::CoordinatedTileUpdate {
    uint32_t tileID;
    WebCore::IntRect tileRect;
    WebCore::IntRect dirtyRect;
    bool supportsAlpha;
    WebKit::CoordinatedPixels pixels;
}

header: "CoordinatedLayerTreeTransaction.h"
[CustomHeader] struct WebKit::CoordinatedBackingStoreUpdate {
    float contentsScale;
    Vector<uint32_t> tilesToCreate;
    Vector<WebKit::CoordinatedTileUpdate> tilesToUpdate;
    Vector<uint32_t> tilesToRemove;
}

header: "CoordinatedLayerTreeTransaction.h"
[CustomHeader] struct WebKit::CoordinatedLayerUpdate {
    WebCore::CoordinatedLayerProperties properties;
    std::optional<WebKit::CoordinatedBackingStoreUpdate> backingStore;
    std::optional<WebKit::CoordinatedPixels> contentsImage;
    std::optional<WebKit::CoordinatedPixels> contentsBuffer;
}

header: "CoordinatedLayerTreeTransaction.h"
struct WebKit::CoordinatedLayerTreeTransaction {
    WebCore::PlatformLayerIdentifier rootLayer;
    Vector<WebKit::CoordinatedLayerUpdate> layers;
    Vector<WebCore::PlatformLayerIdentifier> removedLayers;
    IPC::SharedBufferReference pixels;
}

#endif
