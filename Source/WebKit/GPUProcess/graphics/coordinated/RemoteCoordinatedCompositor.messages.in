#if ENABLE(GPU_PROCESS) && USE(COORDINATED_GRAPHICS) && USE(SKIA) && !USE(TEXTURE_MAPPER)

[
    DispatchedFrom=WebContent,
    DispatchedTo=GPU,
    ExceptionForEnabledBy
]
messages -> RemoteCoordinatedCompositor {
    Commit(struct WebKit::CoordinatedLayerTreeTransaction transaction) -> ()
    UpdateLayers(struct WebKit::CoordinatedLayerTreeTransaction transaction)
    SetSize(WebCore::IntSize size, float deviceScaleFactor)
    SetVisible(bool visible)
    BackgroundColorDidChange(std::optional<WebCore::Color> color)
#if PLATFORM(WPE) && ENABLE(WPE_PLATFORM) && (USE(GBM) || OS(ANDROID))
    PreferredBufferFormatsDidChange(Vector<WebKit::RendererBufferFormat> formats)
#endif
#if ENABLE(DAMAGE_TRACKING)
    SetDamagePropagationSettings(bool propagationEnabled, bool unified, bool usedForCompositing, uint32_t rectangleThreshold)
    EnableFrameDamageNotificationForTesting()
#endif
}

#endif
