#if ENABLE(IMAGE_PROCESS)

[
    DispatchedFrom=Image,
    DispatchedTo=WebContent
]
messages -> RemoteImageDecoderManager {
    # Reports the encoded data status of a decoder after more of its encoded
    # data arrived. All fields mirror the state of the decoder in the Image
    # process; there is one frame info per frame.
    EncodedDataStatusChanged(WebCore::ImageDecoderIdentifier identifier, bool isFailed, bool isAllDataReceived, WebCore::IntSize size, int32_t repetitionCount, Vector<WebCore::ImageDecoderFrameInfo> frameInfos)

    # The frame's shared buffer is ready to be presented. `buffer` is sent
    # with the first result for a frame, and again whenever the Image process
    # replaces the buffer; otherwise the frame's existing buffer was updated in
    # place. A frame that isn't complete yet holds the pixels decoded so far.
    # The frame's duration is only known once it's decoded, so it comes here.
    FrameDecoded(WebCore::ImageDecoderIdentifier identifier, uint64_t index, std::optional<WebCore::ShareableBitmapHandle> buffer, bool succeeded, bool isComplete, WebCore::ImageDecoderFrameInfo frameInfo)
}

#endif // ENABLE(IMAGE_PROCESS)
