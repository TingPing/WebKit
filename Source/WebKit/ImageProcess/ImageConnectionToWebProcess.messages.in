#if ENABLE(IMAGE_PROCESS)

[
    DispatchedFrom=WebContent,
    DispatchedTo=Image,
    ExceptionForEnabledBy
]
messages -> ImageConnectionToWebProcess {
    # Creates a decoder for the Web process. The decoder identifier is
    # generated by the Web process. The decoder fails (and reports Error
    # through EncodedDataStatusChanged) if its encoded data can not be
    # decoded here.
    CreateDecoder(WebCore::ImageDecoderIdentifier identifier, uint8_t alphaOption, uint8_t gammaAndColorProfileOption)

    # Gives the decoder the shared memory the Web process writes the encoded
    # data into. Sent once, and again only if the Web process has to grow it;
    # the new buffer starts with all the data written so far.
    SetEncodedDataBuffer(WebCore::ImageDecoderIdentifier identifier, WebCore::SharedMemory::Handle buffer)

    # The first `size` bytes of the encoded data buffer are valid. The
    # resulting encoded data status is pushed back asynchronously with
    # RemoteImageDecoderManager::EncodedDataStatusChanged().
    EncodedDataAppended(WebCore::ImageDecoderIdentifier identifier, uint64_t size, bool allDataReceived)

    # Decodes the frame at the given index, with the encoded data received so
    # far, into the frame's shared buffer. The result is pushed back with
    # RemoteImageDecoderManager::FrameDecoded().
    DecodeFrame(WebCore::ImageDecoderIdentifier identifier, uint64_t index)

    # Drops any queued (not yet started) decode of the frame at the given
    # index, e.g. because the frame is no longer needed.
    CancelDecode(WebCore::ImageDecoderIdentifier identifier, uint64_t index)

    ClearFrameBufferCache(WebCore::ImageDecoderIdentifier identifier, uint64_t index)

    DeleteDecoder(WebCore::ImageDecoderIdentifier identifier)
}

#endif // ENABLE(IMAGE_PROCESS)
